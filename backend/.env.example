DATABASE_URL=sqlite+aiosqlite:///./huluhilir.db
LITELLM_MODEL=ollama_chat/qwen2.5:14b
OLLAMA_API_BASE=http://localhost:11434
API_BASE_URL=http://localhost:8000
TTS_BASE_URL=http://localhost:8001

# CLOUD path only -- set by deploy-cloud.sh on Cloud Run, not needed locally.
# Auth is the Cloud Run service's own service account; there is no key to set.
# Do NOT "upgrade" the model to a lower-numbered-but-newer-sounding name:
# gemini-2.0-flash and gemini-1.5-flash both 404 against this project's
# Vertex AI in every region tried. See docs/BUILD_LOG.md "Cloud deploy".
# LITELLM_MODEL=vertex_ai/gemini-2.5-flash
# VERTEXAI_PROJECT=sfws-aicc-workspace-1
# VERTEXAI_LOCATION=us-central1

# Only needed if using the Gemini API directly instead of Vertex AI.
GEMINI_API_KEY=
