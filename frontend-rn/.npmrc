# Expo 57's own published dependency graph has an internal peer-dep
# inconsistency right now (react-dom@19.3.0 requires react@^19.3.0, but the
# scaffolded template pins react@19.2.3) -- this is upstream, not caused by
# any package this project added. legacy-peer-deps is the standard,
# low-risk workaround for React Native's over-strict optional peer deps
# (common across the ecosystem, not a sign of an actually broken install).
legacy-peer-deps=true
